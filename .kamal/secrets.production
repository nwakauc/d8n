KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RAILS_MASTER_KEY=$RAILS_MASTER_KEY
D8N_DATABASE_PASSWORD=$D8N_DATABASE_PASSWORD

# Same underlying R2 endpoint/buckets/keys as staging — only the variable
# NAMES differ, to satisfy the app's D8N_DEPLOYMENT_ENV=production lookup
# contract. No new R2 resources, no rotation (per explicit instruction).
D8N_R2_ENDPOINT=$STAGING_R2_ENDPOINT
D8N_R2_HOOKUS_PRODUCTION_ACCESS_KEY_ID=$STAGING_R2_ACCESS_KEY_ID
D8N_R2_HOOKUS_PRODUCTION_SECRET_ACCESS_KEY=$STAGING_R2_SECRET_ACCESS_KEY
D8N_R2_HOOKUS_PRODUCTION_BUCKET=$STAGING_R2_BUCKET
D8N_R2_DATEZA_PRODUCTION_ACCESS_KEY_ID=$STAGING_DATEZA_R2_ACCESS_KEY_ID
D8N_R2_DATEZA_PRODUCTION_SECRET_ACCESS_KEY=$STAGING_DATEZA_R2_SECRET_ACCESS_KEY
D8N_R2_DATEZA_PRODUCTION_BUCKET=$STAGING_DATEZA_R2_BUCKET

# Date9ja has no dedicated bucket yet. Reuses the same account-wide R2 token
# (scoped to reach any existing bucket, proven read/write/delete tonight) and
# the same underlying bucket as HookUs. Media::ObjectKey already namespaces
# every key under brands/date9ja/... so this coexists safely with HookUs's
# and DateZA's brands/<slug>/... objects in the same bucket. Replace with a
# dedicated bucket/token later if stronger storage isolation is wanted.
D8N_R2_DATE9JA_PRODUCTION_ACCESS_KEY_ID=$ACCESS_KEY_ID
D8N_R2_DATE9JA_PRODUCTION_SECRET_ACCESS_KEY=$SECRET_ACCESS_KEY
D8N_R2_DATE9JA_PRODUCTION_BUCKET=$STAGING_R2_BUCKET

RESEND_API_KEY=$RESEND_API_KEY
# Loaded from the deployment shell environment; never commit the key itself.
D8N_AI_OPENAI_API_KEY=$D8N_AI_OPENAI_API_KEY
TWILIO_ACCOUNT_SID=$TWILIO_ACCOUNT_SID
TWILIO_API_KEY_SID=$TWILIO_API_KEY_SID
TWILIO_CLIENT_SECRET=$TWILIO_CLIENT_SECRET
TWILIO_HOOKUS_MESSAGING_SERVICE_SID=$TWILIO_HOOKUS_MESSAGING_SERVICE_SID
TWILIO_DATEZA_MESSAGING_SERVICE_SID=$TWILIO_DATEZA_MESSAGING_SERVICE_SID

D8N_AR_ENCRYPTION_PRIMARY_KEY=$D8N_AR_ENCRYPTION_PRIMARY_KEY
D8N_AR_ENCRYPTION_DETERMINISTIC_KEY=$D8N_AR_ENCRYPTION_DETERMINISTIC_KEY
D8N_AR_ENCRYPTION_KEY_DERIVATION_SALT=$D8N_AR_ENCRYPTION_KEY_DERIVATION_SALT
