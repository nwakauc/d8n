KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RAILS_MASTER_KEY=$RAILS_MASTER_KEY
D8N_DATABASE_PASSWORD=$D8N_DATABASE_PASSWORD

# Bucket-scoped, staging-only R2 credential. Read/write/list access is limited
# to the d8n-staging-media bucket; this must never be the same credential used
# for a future production bucket. See docs/operations/private-media-storage.md.
D8N_R2_ACCESS_KEY_ID=$STAGING_R2_ACCESS_KEY_ID
D8N_R2_SECRET_ACCESS_KEY=$STAGING_R2_SECRET_ACCESS_KEY
D8N_R2_BUCKET=$STAGING_R2_BUCKET
D8N_R2_ENDPOINT=$STAGING_R2_ENDPOINT