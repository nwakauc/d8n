KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RAILS_MASTER_KEY=$RAILS_MASTER_KEY
D8N_DATABASE_PASSWORD=$D8N_DATABASE_PASSWORD

# Bucket-scoped, staging-only R2 credential. Read/write/list access is limited
# to the d8n-staging-media bucket; this must never be the same credential used
# for a future production bucket. See docs/operations/private-media-storage.md.
D8N_R2_ACCESS_KEY_ID=$STAGING_R2_ACCESS_KEY_ID
D8N_R2_SECRET_ACCESS_KEY=$STAGING_R2_SECRET_ACCESS_KEY
D8N_R2_BUCKET=$STAGING_R2_BUCKET
D8N_R2_ENDPOINT=$STAGING_R2_ENDPOINT

# Brand-specific staging services. HookUs reuses the existing private bucket and
# bucket-scoped credential; DateZA receives a distinct private bucket/credential.
D8N_R2_HOOKUS_STAGING_ACCESS_KEY_ID=$STAGING_R2_ACCESS_KEY_ID
D8N_R2_HOOKUS_STAGING_SECRET_ACCESS_KEY=$STAGING_R2_SECRET_ACCESS_KEY
D8N_R2_HOOKUS_STAGING_BUCKET=$STAGING_R2_BUCKET
D8N_R2_DATEZA_STAGING_ACCESS_KEY_ID=$STAGING_DATEZA_R2_ACCESS_KEY_ID
D8N_R2_DATEZA_STAGING_SECRET_ACCESS_KEY=$STAGING_DATEZA_R2_SECRET_ACCESS_KEY
D8N_R2_DATEZA_STAGING_BUCKET=$STAGING_DATEZA_R2_BUCKET

# Transactional delivery providers. Resolved from the deploy host environment
# (.env / password manager); the app fails closed (no send) until each is present.
RESEND_API_KEY=$RESEND_API_KEY
# Twilio Standard API Key auth (no account auth token). TWILIO_CLIENT_SECRET is the
# API Key secret, matching the name established in the production environment.
TWILIO_ACCOUNT_SID=$TWILIO_ACCOUNT_SID
TWILIO_API_KEY_SID=$TWILIO_API_KEY_SID
TWILIO_CLIENT_SECRET=$TWILIO_CLIENT_SECRET
TWILIO_HOOKUS_MESSAGING_SERVICE_SID=$TWILIO_HOOKUS_MESSAGING_SERVICE_SID
TWILIO_DATEZA_MESSAGING_SERVICE_SID=$TWILIO_DATEZA_MESSAGING_SERVICE_SID

# Active Record Encryption keys for OTP delivery_code ciphertext. MANDATORY:
# the app raises at boot in production if any is missing.
D8N_AR_ENCRYPTION_PRIMARY_KEY=$D8N_AR_ENCRYPTION_PRIMARY_KEY
D8N_AR_ENCRYPTION_DETERMINISTIC_KEY=$D8N_AR_ENCRYPTION_DETERMINISTIC_KEY
D8N_AR_ENCRYPTION_KEY_DERIVATION_SALT=$D8N_AR_ENCRYPTION_KEY_DERIVATION_SALT
