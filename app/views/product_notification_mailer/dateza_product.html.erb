<div style="display: none; max-height: 0; overflow: hidden; opacity: 0; color: transparent;"><%= @preheader %></div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width: 100%; margin: 0; padding: 0; background-color: #FFF8F6;">
  <tr>
    <td align="center" style="padding: 28px 16px;">
      <!--[if mso]><table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width: 100%; max-width: 600px; background-color: #FFFFFF; border: 1px solid #E4DBE0; border-radius: 18px;">
        <tr><td style="padding: 30px 32px 18px;"><%= render "mailers/dateza_logo" %></td></tr>
        <tr>
          <td style="padding: 14px 32px 36px; font-family: Arial, Helvetica, sans-serif; color: #1C1720;">
            <div style="width: 44px; height: 4px; margin-bottom: 22px; background-color: #E8375A; line-height: 4px; font-size: 4px;">&nbsp;</div>
            <% if @actor_image_url.present? %>
              <img src="<%= @actor_image_url %>" alt="<%= @actor_name %>" width="72" height="72" style="display: block; width: 72px; height: 72px; margin: 0 0 18px; border-radius: 50%; object-fit: cover; border: 3px solid #FBE7EC;">
            <% end %>
            <h1 style="margin: 0 0 14px; font-size: 30px; line-height: 38px; font-weight: 750; letter-spacing: -0.6px; color: #1C1720;"><%= @title %></h1>
            <p style="margin: 0; max-width: 500px; font-size: 16px; line-height: 26px; color: #5F5566;"><%= @body %></p>
            <% if @cta_url.present? && @cta_label.present? %>
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin-top: 26px;"><tr><td bgcolor="#E8375A" style="border-radius: 999px;"><a href="<%= @cta_url %>" style="display: inline-block; padding: 13px 24px; font-size: 16px; line-height: 20px; font-weight: 700; font-family: Arial, Helvetica, sans-serif; color: #FFFFFF; text-decoration: none;"><%= @cta_label %></a></td></tr></table>
            <% end %>
            <p style="margin: 28px 0 0; padding-top: 18px; border-top: 1px solid #EEE7EA; font-size: 13px; line-height: 20px; color: #7A6F80;">This notification was sent for your DateZA account. Private message media is never attached to notification emails.</p>
          </td>
        </tr>
      </table>
      <!--[if mso]></td></tr></table><![endif]-->
    </td>
  </tr>
</table>
