<div style="display: none; max-height: 0; overflow: hidden; opacity: 0; color: transparent;">Your DateZA verification code expires in 10 minutes.</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width: 100%; margin: 0; padding: 0; background-color: #FFF8F6;">
  <tr>
    <td align="center" style="padding: 28px 16px;">
      <!--[if mso]><table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width: 100%; max-width: 600px; background-color: #FFFFFF; border: 1px solid #E4DBE0;">
        <tr>
          <td style="padding: 30px 32px 18px;">
            <%= render "mailers/dateza_logo" %>
          </td>
        </tr>
        <tr>
          <td style="padding: 14px 32px 34px; font-family: Arial, Helvetica, sans-serif; color: #1C1720;">
            <h1 style="margin: 0 0 14px; font-size: 30px; line-height: 38px; font-weight: 750; letter-spacing: -0.6px; color: #1C1720;">Verify your email</h1>
            <p style="margin: 0 0 24px; font-size: 16px; line-height: 25px; color: #5F5566;">Use this code to verify your DateZA account.</p>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width: 100%; background-color: #FFF0F3; border: 1px solid #F2C8D1;">
              <tr>
                <td align="center" style="padding: 22px 16px; font-family: 'Courier New', Courier, monospace; font-size: 34px; line-height: 40px; font-weight: 700; letter-spacing: 7px; color: #9A1D3A;">
                  <%= @code %>
                </td>
              </tr>
            </table>
            <p style="margin: 20px 0 0; font-size: 15px; line-height: 23px; color: #5F5566;">This code expires in 10 minutes.</p>
            <p style="margin: 12px 0 0; padding-top: 18px; border-top: 1px solid #EEE7EA; font-size: 13px; line-height: 20px; color: #7A6F80;">If you didn't request this, you can safely ignore this email.</p>
          </td>
        </tr>
      </table>
      <!--[if mso]></td></tr></table><![endif]-->
    </td>
  </tr>
</table>
