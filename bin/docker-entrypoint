#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# If running the rails server or the Solid Queue worker, create/migrate both
# configured databases (primary + queue) first. db:prepare is idempotent, so
# this keeps each role self-contained regardless of which one boots first.
if { [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; } || [ "${@: -1}" == "bin/jobs" ]; then
  ./bin/rails db:prepare
fi

# Brand-to-host resolution is DB-backed (BrandDomain), not env/config-driven.
# DATEZA_API_HOST maps this environment's DateZA hostname to the shared
# BrandRegistry via the idempotent brands:install_dateza task, so the mapping
# can't be silently missing in a freshly provisioned environment.
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ] && [ -n "${DATEZA_API_HOST}" ]; then
  ./bin/rails brands:install_dateza
fi

# Date9ja is a required first-class tenant in every D8N environment. The
# ensure task creates only missing safe defaults; DATE9JA_API_HOST is optional
# and adds a DB-backed host mapping when that environment is approved to serve
# Date9ja traffic.
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails brands:ensure_date9ja
fi

exec "${@}"
