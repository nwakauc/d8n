# Committed, secret-free test-environment defaults.
#
# dotenv loads `.env.test` before `.env`, and never overrides a value a
# previous file already set — so these pin the test suite to safe, local-only
# adapters regardless of what a developer's own `.env` carries for
# development/staging/production use (real Resend/Twilio/OpenAI keys, a
# production-shaped CORS allowlist, etc.). Without this file, `bin/rails test`
# silently inherited those values (no `.env.test` existed before), which
# caused ~12 spurious mailer/CORS test failures in Date9ja Pass 2 and is a
# live cost/safety risk for SMS and AI provider calls.
#
# Do not add real credentials here — this file is committed.

# Deliver through ActionMailer's test adapter (Rails.env.test? already makes
# ActionMailer capture, not send), never the real Resend API.
D8N_EMAIL_PROVIDER=action_mailer

# No SMS provider configured: Notifications::Sms.gateway falls back to a
# no-op "null" gateway outside production. Prevents any accidental real
# Twilio spend during test runs.
D8N_SMS_PROVIDER=null

# No AI provider configured: Ai::ProviderRegistry falls back to "disabled"
# outside production. Prevents any accidental real OpenAI spend during test
# runs.
D8N_AI_PROVIDER=disabled

# The same local/test origins config/initializers/cors.rb already hard-codes
# as its own test-env default — pinned explicitly so a developer's
# production-shaped D8N_CORS_ORIGINS in `.env` can never suppress them.
D8N_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3200,http://date9ja.localhost:3200,http://localhost:5173,https://dateza.vercel.app,https://date9ja-seo-frontend.vercel.app
